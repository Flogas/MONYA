@startuml
skinparam shadowing false
skinparam monochrome true
skinparam dpi 300
skinparam defaultFontSize 11
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

start

:Инициализация виртуального прибора учёта;

:Начало цикла измерения;

repeat

  :Генерация параметров электропотребления\n(мощность, напряжение, ток, энергия, cosφ);

  :Формирование пакета данных;

  :Передача данных на сервер\n(MQTT / WebSocket);

  if (Данные успешно доставлены?) then (да)
    :Валидация полученных данных;
    
    if (Валидация пройдена успешно?) then (да)
      :Первичная обработка данных;
      :Запись данных в базу PostgreSQL;
      
      fork
        :Расчёт производных показателей\n(профили нагрузки, максимумы мощности);
      fork again
        :Интеллектуальный анализ;
        :Прогнозирование потребления;
        :Выявление аномалий\n(Isolation Forest);
        
        if (Аномалия обнаружена?) then (да)
          :Формирование и отправка уведомления;
        endif
      end fork
      
      :Подготовка данных для визуализации;
      
    else (нет)
      :Обработка ошибки валидации;
      :Запись события в журнал;
    endif
    
  else (нет)
    :Переход в режим буферизации;
    :Локальное хранение данных;
  endif

repeat while (Продолжать измерение?) is (да)

:Завершение сеанса работы системы;

stop

@enduml